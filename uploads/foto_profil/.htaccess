# Folder ini hanya berisi gambar foto profil.
# Cegah file skrip dijalankan walaupun ada yang berhasil terunggah.
<FilesMatch "\.(php|phtml|php\d|phar|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

Options -Indexes
